APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# China Mobile Cloud (移动云) Integration
ECLOUD_ACCESS_KEY=
ECLOUD_SECRET_KEY=
ECLOUD_GATEWAY_URL=https://gateway.ecloud.10086.cn/api
ECLOUD_PHONE_VERIFY_ENABLED=false
ECLOUD_CONTENT_AUDIT_ENABLED=false
ECLOUD_AUDIT_BLOCK_ACTION=block
ECLOUD_AUDIT_FAIL_OPEN=true
ECLOUD_AUDIT_CALLBACK_URL=

# ==== 多平台认证与审核 (多Provider驱动) ====
# 驱动选择: identity_verify(aliyun|tencent|alipay|wechat) phone_verify(ecloud|aliyun|tencent) content_security(ecloud|aliyun|tencent)
IDENTITY_VERIFY_DRIVER=aliyun
PHONE_VERIFY_DRIVER=ecloud
CONTENT_SECURITY_DRIVER=ecloud
CONTENT_SECURITY_CALLBACK_URL=

# --- 阿里云实人认证 (二要素/三要素/银行卡) ---
ALIYUN_IDENTITY_ENABLED=false
ALIYUN_IDENTITY_ACCESS_KEY_ID=
ALIYUN_IDENTITY_ACCESS_KEY_SECRET=
ALIYUN_IDENTITY_ENDPOINT=idvi.cn-shanghai.aliyuncs.com

# --- 腾讯云人脸核身 ---
TENCENT_IDENTITY_ENABLED=false
TENCENT_IDENTITY_SECRET_ID=
TENCENT_IDENTITY_SECRET_KEY=
TENCENT_IDENTITY_REGION=ap-guangzhou

# --- 支付宝实名认证 ---
ALIPAY_IDENTITY_ENABLED=false
ALIPAY_IDENTITY_APP_ID=
ALIPAY_IDENTITY_PRIVATE_KEY=
ALIPAY_IDENTITY_PUBLIC_KEY=
ALIPAY_IDENTITY_GATEWAY=https://openapi.alipay.com/gateway.do

# --- 微信实名认证 (灰度中) ---
WECHAT_IDENTITY_ENABLED=false
WECHAT_IDENTITY_APP_ID=
WECHAT_IDENTITY_MCH_ID=
WECHAT_IDENTITY_API_KEY=

# --- 阿里云号码认证 (PNVS) ---
ALIYUN_PHONE_VERIFY_ENABLED=false
ALIYUN_PHONE_VERIFY_ACCESS_KEY_ID=
ALIYUN_PHONE_VERIFY_ACCESS_KEY_SECRET=
ALIYUN_PHONE_VERIFY_ENDPOINT=dypnsapi.cn-hangzhou.aliyuncs.com

# --- 腾讯云手机号三要素 ---
TENCENT_PHONE_VERIFY_ENABLED=false
TENCENT_PHONE_VERIFY_SECRET_ID=
TENCENT_PHONE_VERIFY_SECRET_KEY=
TENCENT_PHONE_VERIFY_REGION=ap-guangzhou

# --- 阿里云内容安全 ---
ALIYUN_CONTENT_SECURITY_ENABLED=false
ALIYUN_CONTENT_SECURITY_ACCESS_KEY_ID=
ALIYUN_CONTENT_SECURITY_ACCESS_KEY_SECRET=
ALIYUN_CONTENT_SECURITY_ENDPOINT=green.cn-shanghai.aliyuncs.com

# --- 腾讯云内容安全 (CMS) ---
TENCENT_CONTENT_SECURITY_ENABLED=false
TENCENT_CONTENT_SECURITY_SECRET_ID=
TENCENT_CONTENT_SECURITY_SECRET_KEY=
TENCENT_CONTENT_SECURITY_REGION=ap-guangzhou
